# OpenAI API Key (required)
OPENAI_API_KEY=your_api_key_here

# Model Configuration (optional)
# Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Maximum generated tokens for builder and comparison model calls.
# Uses max_completion_tokens, which is required by reasoning models.
OPENAI_MAX_COMPLETION_TOKENS=32768

# Reasoning models only. Low is suited to execution-oriented code generation.
OPENAI_REASONING_EFFORT=low

# Python-only production architecture policy. Defaults to ./backend-prompt.md.
# The selected file must contain numbered sections 1 through 36.
# BACKEND_POLICY_PATH=/absolute/path/to/backend-prompt.md

# For Python selections, use the configured model to split dense feature descriptions into atomic requirements.
# Failures fall back to the deterministic parser.
REQUIREMENTS_MODEL_ENABLED=true

# Optional observability rates used to estimate cost per request.
# Keep these aligned with the configured model's per-million-token prices.
# OPENAI_INPUT_COST_PER_1M=0
# OPENAI_OUTPUT_COST_PER_1M=0
# OPENAI_CACHED_INPUT_COST_PER_1M=0

# Ask for missing requirements before continuing.
CLARIFICATION_GATE_ENABLED=true

# Control-plane API and durable execution
CONTROL_DATABASE_URL=postgresql+asyncpg://app_builder:app_builder@127.0.0.1:5433/app_builder
CONTROL_BROKER_URL=amqp://app_builder:app_builder@127.0.0.1:5672/app_builder
CONTROL_REDIS_URL=redis://127.0.0.1:6379/0
CONTROL_ARTIFACT_ROOT=./data
# Retain generated source under data/ after successful GitHub delivery.
# Generation always uses a local workspace; false removes only builds/ after publishing.
CONTROL_RETAIN_LOCAL_BUILDS=true
# Optional escape hatch: publish successfully generated code even when its
# final quality gate fails. The run itself remains failed.
CONTROL_PUBLISH_ON_QUALITY_FAILURE=false
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8080
# Python execution rollout mode. Start with dynamic_serial; dynamic_parallel is
# reserved until shared workspace storage and conflict-safe merges are enabled.
CONTROL_EXECUTION_MODE=legacy
# Optional. When set, API clients must send this value in X-API-Key.
# CONTROL_API_KEY=

# GitHub delivery. When owner and token are configured, successful runs are
# published after quality and traceability gates pass. Set the escape hatch
# above to publish generated code after a failed quality gate as well.
# GITHUB_OWNER=your-github-username
# GITHUB_TOKEN=github_pat_xxxxxxxxx
GITHUB_REPOSITORY_VISIBILITY=private
# GITHUB_COMMIT_AUTHOR_NAME=Your Name
# GITHUB_COMMIT_AUTHOR_EMAIL=you@example.com
