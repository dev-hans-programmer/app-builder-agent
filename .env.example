# OpenAI API Key (required)
OPENAI_API_KEY=your_api_key_here

# Model Configuration (optional)
# Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Maximum generated tokens for builder and comparison model calls.
# Uses max_completion_tokens, which is required by reasoning models.
OPENAI_MAX_COMPLETION_TOKENS=32768

# Reasoning models only. Low is suited to execution-oriented code generation.
OPENAI_REASONING_EFFORT=low

# Optional observability rates used to estimate cost per request.
# Keep these aligned with the configured model's per-million-token prices.
# OPENAI_INPUT_COST_PER_1M=0
# OPENAI_OUTPUT_COST_PER_1M=0
# OPENAI_CACHED_INPUT_COST_PER_1M=0

# Ask for missing requirements before continuing.
CLARIFICATION_GATE_ENABLED=true
